{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true
  },
  "include": [
    "index.js",
    "src/**/*.ts",
    "src/**/*.mjs",
    "extensions/**/*.ts",
    "extensions/**/*.mjs"
  ]
}
